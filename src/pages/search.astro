---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Search',
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-8 font-heading">Search</h1>
    <input
      id="search-input"
      type="text"
      placeholder="Search..."
      autofocus
      class="w-full px-4 py-3 mb-6 text-lg border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-slate-800 text-default focus:outline-none focus:ring-2 focus:ring-blue-500"
    />
    <div id="search-results" class="space-y-4"></div>
  </section>
</Layout>

<script is:inline>
  async function initPagefind() {
    var input = document.getElementById('search-input');
    var results = document.getElementById('search-results');
    if (!input || !results || input.dataset.initialized) return;
    input.dataset.initialized = 'true';

    var pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      pagefind.init();
    } catch (e) {
      results.innerHTML = '<p class="text-muted">Search index not available. Run <code>npm run build</code> first, then use <code>npm run preview</code>.</p>';
      return;
    }

    var params = new URLSearchParams(window.location.search);
    var query = params.get('q') || '';
    if (query) input.value = query;

    async function doSearch(term) {
      results.innerHTML = '';
      if (!term.trim()) return;

      var search = await pagefind.search(term);
      if (search.results.length === 0) {
        results.innerHTML = '<p class="text-muted">No results found.</p>';
        return;
      }

      for (var result of search.results.slice(0, 20)) {
        var data = await result.data();
        var item = document.createElement('a');
        item.href = data.url;
        item.className =
          'block p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors';
        item.innerHTML =
          '<h2 class="text-lg font-semibold text-blue-800 dark:text-blue-400">' + (data.meta.title || data.url) + '</h2>' +
          '<p class="text-sm text-muted mt-1">' + data.excerpt + '</p>';
        results.appendChild(item);
      }
    }

    input.addEventListener('input', function() { doSearch(input.value); });
    if (query) doSearch(query);
  }

  initPagefind();
  document.addEventListener('astro:after-swap', initPagefind);
</script>
