---
import Layout from '~/layouts/LandingLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps2 from '~/components/widgets/Steps2.astro';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About"
    title="Who we are"
    subtitle='Founded by <a href="https://www.linkedin.com/in/alexgonzalezgarcia/" target="_blank" class="text-blue-800 dark:text-blue-400 hover:underline">Alex Gonzalez</a>, MuXu are embedded Linux experts based in La Rioja, Spain. We specialize in helping start-ups succeed, from proof of concepts to production certified software products.'
  />

  <!-- Team expertise Widget ************** -->

  <Features3
    title="What we bring"
    subtitle="Our team combines deep technical expertise with hands-on experience shipping embedded Linux at scale."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'Embedded Linux & Yocto Project',
        description: 'Custom Linux distributions, BSP development, and production-grade OS builds using the Yocto Project and OpenEmbedded.',
        icon: 'tabler:brand-debian',
      },
      {
        title: 'Containerized workloads',
        description: 'Container engine integration, application isolation and orchestration on resource-constrained embedded devices.',
        icon: 'tabler:box',
      },
      {
        title: 'Linux kernel & ARM platforms',
        description: 'Kernel BSP maintenance, device driver development and board bring-up across ARM system-on-module platforms.',
        icon: 'tabler:cpu',
      },
    ]}
  />

  <!-- Track record Widget ************** -->

  <Steps2
    title="Track record"
    subtitle="We work at the edge — building the software that powers smart devices and robots, from proof of concept to production at scale."
    items={[
      {
        title: 'Published expertise',
        description: 'Author of <a href="https://www.amazon.com/Embedded-Linux-Development-Project-Cookbook/dp/1788399218" target="_blank" class="text-blue-800 dark:text-blue-400 hover:underline">"Embedded Linux Development Using Yocto Project Cookbook"</a> (Packt Publishing) — practical recipes for professional embedded Linux developers.',
      },
      {
        title: 'Open source contributions',
        description: 'Maintainers of multiple ARM board support packages in the Linux kernel. Active contributors to the Yocto Project and the broader embedded Linux ecosystem.',
      },
    ]}
  />

</Layout>
